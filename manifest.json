{
  "manifest_version": 3,
  "name": "Bitbot X Panel",
  "version": "1.0",
  "description": "View Twitter & gmgn.ai in a side panel",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "sidePanel.open",
    "webRequest",
    "webRequestBlocking",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.gmgn.ai/*",
    "*://*.cloudflare.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "fetch_service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.gmgn.ai/*"],
      "js": ["gmgn_injected_js.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src *"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "popup.html", "popup.js", "icons/*"],
      "matches": [
        "https://*.x.com/*",
        "https://x.com/*",
        "https://*.twitter.com/*",
        "https://twitter.com/*",
        "https://*.twimg.com/*",
        "https://*.gmgn.ai/*",
        "https://gmgn.ai/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open BitBot Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
} 